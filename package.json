{
  "name": "dialscope",
  "version": "1.1.0",
  "description": "Offline phone lookup and contact cleaning toolkit with an optional Fastify API",
  "author": "shazarkk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shazzark/dialscope.git"
  },
  "homepage": "https://github.com/shazzark/dialscope#readme",
  "bugs": {
    "url": "https://github.com/shazzark/dialscope/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "licenses"
  ],
  "bin": {
    "dialscope": "dist/cli.js",
    "dialscope-api": "dist/server.js"
  },
  "scripts": {
    "dev": "npm run build --silent && node dist/cli.js",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "verify:packed": "node scripts/verify-packed-package.mjs",
    "start:api": "npm run build --silent && node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.0",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "fastify": "5.12.7",
    "libphonenumber-geo-carrier": "2.0.0",
    "libphonenumber-js": "1.13.15"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "vitest": "5.0.4"
  }
}
