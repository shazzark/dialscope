{
  "name": "dialscope",
  "version": "1.0.0",
  "description": "Offline phone-number lookup CLI and Node.js library",
  "author": "shazarkk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shazzark/dialscope.git"
  },
  "homepage": "https://github.com/shazzark/dialscope#readme",
  "bugs": {
    "url": "https://github.com/shazzark/dialscope/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "THIRD-PARTY-NOTICES.md", "licenses"],
  "bin": {
    "dialscope": "dist/cli.js"
  },
  "scripts": {
    "dev": "npm run build --silent && node dist/cli.js",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "libphonenumber-geo-carrier": "2.0.0",
    "libphonenumber-js": "1.12.31"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "vitest": "5.0.4"
  }
}
